
# BITÁCORA LIGHTYEAR

#  Python / FastAPI (backend) 

# Caché y archivos compilados de Python

**pycache**/
*.py[cod]
*$py.class

# Entornos virtuales

.venv/
venv/
env/

# Variables de entorno y secretos

.env
.env.*
!.env.example

# Herramientas de desarrollo de Python

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Archivos de distribución

dist/
build/
*.egg-info/

#  Archivos de audio generados 

# Audios recibidos o generados durante la ejecución

/backend/uploads/*
!/backend/uploads/.gitkeep

#  Flutter / Dart (frontend) 

# Archivos generados por Flutter y Dart

/frontend/.dart_tool/
/frontend/.flutter-plugins
/frontend/.flutter-plugins-dependencies
/frontend/build/
/frontend/coverage/

# Configuración local del SDK de Flutter/Android

/frontend/android/local.properties

# Archivos de compilación de Android

/frontend/android/.gradle/
/frontend/android/.kotlin/

# Configuración local de IDE

/frontend/.idea/
/frontend/*.iml
/frontend/android/*.iml

# Configuración generada por herramientas

/frontend/android/captures/
/frontend/android/gradlew
/frontend/android/gradlew.bat

#  Sistema operativo 

# Windows

Thumbs.db
Desktop.ini
*.lnk

# macOS

.DS_Store

#  Editores 

# Visual Studio Code: configuración personal

.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Archivos temporales y de respaldo

*.tmp
*.bak
*.swp
*.swo
